# H3-05 LLM baseline — ortam değişkenleri örneği.
# Bu dosyayı `.env` olarak KOPYALAYIN ve gerçek anahtarınızı girin. `.env` gitignore'ludur.
# Anahtar kaynak koda, loglara veya GitHub'a ASLA eklenmez.

# Groq API anahtarı (https://console.groq.com -> API Keys). "gsk_" ile başlar.
GROQ_API_KEY=

# Model (opsiyonel; varsayılan aşağıdadır). LiteLLM biçimi: groq/<model>.
# Not: Issue #31 "Llama 3.3 70B" der; ancak bu model Groq kataloğunda erişilemediğinden
# açık-ağırlıklı gpt-oss-120b kullanılmıştır (bkz. README "Model notu").
LLM_MODEL=groq/openai/gpt-oss-120b

# Üretim parametreleri (opsiyonel)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=60

