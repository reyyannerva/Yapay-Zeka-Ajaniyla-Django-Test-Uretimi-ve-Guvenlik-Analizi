# Backend ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env git tarafından yok sayılır; gerçek parola, token veya API anahtarı depoya ASLA eklenmez.
# Bu örnek dosyada yalnızca yer tutucu (placeholder) değerler bulunur.

# =====================================================================
# Django (H4-01 / #33)
# =====================================================================
# DEBUG kapalıyken (false) SECRET_KEY zorunludur; boşsa backend başlamaz.
DJANGO_SECRET_KEY=degistirin-uzun-rastgele-bir-deger
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================================================
# PostgreSQL (zorunlu; SQLite desteklenmez) (H4-01 / #33)
# =====================================================================
POSTGRES_DB=ai_test_agent
POSTGRES_USER=ai_test_agent
POSTGRES_PASSWORD=degistirin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# İsteğe bağlı
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=0

# =====================================================================
# Kimlik doğrulama / JWT (H4-02 / #34)
# =====================================================================
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Anonim giriş çağrılarına istek sınırlaması (DRF throttle oranı).
LOGIN_THROTTLE_RATE=10/min

# =====================================================================
# Giriş kilidi (django-axes) (H4-01 / #33, H4-06 / #38 ile yapılandırılabilir)
# =====================================================================
# Varsayılanlar isterlerdeki davranışı korur: 3 başarısız denemede 15 dakika kilit.
AXES_FAILURE_LIMIT=3
AXES_COOLOFF_MINUTES=15

# =====================================================================
# E-posta / şifre sıfırlama (H4-02 / #34, SMTP: H4-06 / #38)
# =====================================================================
# Geliştirmede konsol backend yeterlidir; üretimde SMTP kullanın.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TIMEOUT=3600
# SMTP ayarları (EMAIL_BACKEND SMTP ise kullanılır). Parola yalnızca .env'de tutulur.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# =====================================================================
# CORS / CSRF (frontend erişimi) (H4-06 / #38)
# =====================================================================
# İzin verilen frontend adresleri (virgülle ayrılır; yıldız izin kullanılmaz).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
# Boş bırakılırsa CORS_ALLOWED_ORIGINS değeri kullanılır.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =====================================================================
# Redis / Celery (ileride asenkron yürütme) (H4-06 / #38)
# =====================================================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Boş bırakılırsa CELERY_BROKER_URL değeri kullanılır.
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# =====================================================================
# AI model sağlayıcıları (H4-06 / #38, İST-05/İST-11)
# =====================================================================
# Anahtarlar opsiyoneldir: eksikse backend yine de başlar; ilgili sağlayıcı
# KULLANILDIĞINDA anlaşılır bir hata verir (gizli değer sızdırılmaz).
LLM_DEFAULT_PROVIDER=groq
LLM_REQUEST_TIMEOUT=60
# Groq (bulut). Gerçek anahtar yalnızca .env'de; buraya yazmayın.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (bulut, karşılaştırma).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Ollama (yerel; API anahtarı gerektirmez).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# =====================================================================
# Proje arşivi yükleme (H4-03 / #35)
# =====================================================================
# PROJECT_ARCHIVE_ROOT=/var/lib/ai-test-agent/archives
# PROJECT_UPLOAD_MAX_BYTES=52428800
# PROJECT_UPLOAD_MAX_UNCOMPRESSED_BYTES=209715200
# PROJECT_UPLOAD_THROTTLE_RATE=30/hour

# =====================================================================
# Üretim güvenlik sertleştirmesi (yalnızca DJANGO_DEBUG=false iken etkin) (H4-06 / #38)
# =====================================================================
# Aşağıdakiler varsayılan olarak etkindir; HTTPS olmayan bir ortamda geçici olarak kapatılabilir.
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# SECURE_PROXY_SSL_HEADER=true
