# H4-01 backend ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env git tarafından yok sayılır; gerçek parola veya anahtar depoya eklenmez.

# Django
DJANGO_SECRET_KEY=degistirin-uzun-rastgele-bir-deger
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (zorunlu; SQLite desteklenmez)
POSTGRES_DB=ai_test_agent
POSTGRES_USER=ai_test_agent
POSTGRES_PASSWORD=degistirin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# İsteğe bağlı
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_CONN_MAX_AGE=0

# Proje arşivi yükleme (H4-03). Varsayılanlar backend/docs/h4_03_project_api.md §4'te.
# PROJECT_ARCHIVE_ROOT=/var/lib/ai-test-agent/archives
# PROJECT_UPLOAD_MAX_BYTES=52428800
# PROJECT_UPLOAD_MAX_UNCOMPRESSED_BYTES=209715200
# PROJECT_UPLOAD_THROTTLE_RATE=30/hour

# API dokümantasyonu (H4-05). true: /api/schema/, /api/docs/, /api/redoc/ herkese açık;
# false: yalnızca personel (is_staff). Varsayılan DJANGO_DEBUG değeridir; üretimde false önerilir.
# API_DOCS_PUBLIC=false
