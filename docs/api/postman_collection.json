                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password-reset",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kullanici@example.test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Kayıtlı olsun olmasın aynı genel yanıt döner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Yeni parola belirle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/password-reset/confirm/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password-reset",
                "confirm",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"{{resetUid}}\",\n  \"token\": \"{{resetToken}}\",\n  \"new_password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "uid ve token e-postadaki bağlantıdan alınır; tek kullanımlıktır."
          }
        }
      ]
    },
    {
